rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default connection test
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow users to read and write user profile and subcollections
    match /users/{userId} {
      allow read, write: if true;

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if true;
      }

      // Revisions subcollection
      match /revisions/{cardId} {
        allow read, write: if true;
      }
    }

    // Fallback deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
